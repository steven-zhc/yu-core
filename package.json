{
  "name": "@yu/core",
  "description": "Yu Core",
  "version": "0.0.1",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node-lts": "^22.0.2",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitest/coverage-v8": "^4.0.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "emittery": "^1.0.3",
    "nanoid": "^5.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./state-sourcing": {
      "types": "./dist/state-sourcing/index.d.ts",
      "default": "./dist/state-sourcing/index.js"
    },
    "./event-sourcing": {
      "types": "./dist/event-sourcing/index.d.ts",
      "default": "./dist/event-sourcing/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./data/patch": {
      "types": "./dist/data/patch.d.ts",
      "default": "./dist/data/patch.js"
    },
    "./data/typeclass": {
      "types": "./dist/data/typeclass.d.ts",
      "default": "./dist/data/typeclass.js"
    }
  },
  "typesVersions": {
    "*": {
      "domain": [
        "dist/domain/index.d.ts"
      ],
      "state-sourcing": [
        "dist/state-sourcing/index.d.ts"
      ],
      "event-sourcing": [
        "dist/event-sourcing/index.d.ts"
      ]
    }
  }
}
